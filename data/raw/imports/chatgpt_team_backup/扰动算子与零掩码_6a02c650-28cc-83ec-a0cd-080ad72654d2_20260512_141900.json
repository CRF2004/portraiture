    "f5b3ab8a-a91c-4eac-a7b1-8dfa912ceba8": {
      "id": "f5b3ab8a-a91c-4eac-a7b1-8dfa912ceba8",
      "message": {
        "id": "f5b3ab8a-a91c-4eac-a7b1-8dfa912ceba8",
        "author": {
          "role": "user",
          "name": null,
          "metadata": {}
