    "9a9c0e45-fa7b-4998-9097-a4dbba14b35f": {
      "id": "9a9c0e45-fa7b-4998-9097-a4dbba14b35f",
      "message": {
        "id": "9a9c0e45-fa7b-4998-9097-a4dbba14b35f",
        "author": {
          "role": "assistant",
