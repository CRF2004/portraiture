    "a9dc2bc2-7338-4217-91e6-d4d4e7b32998": {
      "id": "a9dc2bc2-7338-4217-91e6-d4d4e7b32998",
      "message": {
        "id": "a9dc2bc2-7338-4217-91e6-d4d4e7b32998",
        "author": {
          "role": "assistant",
