    "0d8d9fd9-c12e-4eb3-b798-9ba1ab8cf2df": {
      "id": "0d8d9fd9-c12e-4eb3-b798-9ba1ab8cf2df",
      "message": {
        "id": "0d8d9fd9-c12e-4eb3-b798-9ba1ab8cf2df",
        "author": {
          "role": "assistant",
