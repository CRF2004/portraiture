    "249cb99a-6ce1-4cda-9e7c-9ee99e0dfe35": {
      "id": "249cb99a-6ce1-4cda-9e7c-9ee99e0dfe35",
      "message": {
        "id": "249cb99a-6ce1-4cda-9e7c-9ee99e0dfe35",
        "author": {
          "role": "assistant",
          "name": null,
          "metadata": {}
