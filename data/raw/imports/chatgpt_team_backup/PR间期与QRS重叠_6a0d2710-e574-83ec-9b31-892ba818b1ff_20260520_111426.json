    "1ad5b3c5-c72b-4515-942f-26254ebce6d8": {
      "id": "1ad5b3c5-c72b-4515-942f-26254ebce6d8",
      "message": {
        "id": "1ad5b3c5-c72b-4515-942f-26254ebce6d8",
        "author": {
          "role": "assistant",
